{
  "name": "@inkweaver/editor-web",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react --external react-dom",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inkweaver/api": "workspace:*",
    "@inkweaver/editor-core": "workspace:*",
    "@inkweaver/shared": "workspace:*",
    "@tiptap/core": "^2.5.8",
    "@tiptap/extension-code-block-lowlight": "^2.11.7",
    "@tiptap/extension-image": "2.27.2",
    "@tiptap/extension-link": "2.27.2",
    "@tiptap/extension-task-item": "2.27.2",
    "@tiptap/extension-task-list": "2.27.2",
    "@tiptap/extension-underline": "2.27.2",
    "@tiptap/pm": "^2.5.8",
    "@tiptap/react": "^2.5.8",
    "@tiptap/starter-kit": "^2.12.0",
    "lowlight": "^2.1.0",
    "lucide-react": "^0.294.0"
  },
  "devDependencies": {
    "eslint": "^9.33.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
