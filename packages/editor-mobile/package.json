{
  "name": "@inkweaver/editor-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react --external react-native",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inkweaver/editor-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "eslint": "^9.33.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": "^0.75.0",
    "react-native-webview": "^13.0.0"
  }
}
