{
  "name": "@inkweaver/sync-client",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inkweaver/api": "workspace:*",
    "@inkweaver/db-adapter": "workspace:*",
    "@inkweaver/services": "workspace:*",
    "@inkweaver/shared": "workspace:*",
    "@inkweaver/sync-engine": "workspace:*",
    "socket.io-client": "^4.8.3",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "eslint": "^9.33.0",
    "typescript": "^5.9.3"
  }
}
