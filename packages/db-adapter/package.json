{
  "name": "@inkweaver/db-adapter",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "react-native": "./dist/web/index.cjs",
      "import": "./dist/web/index.mjs",
      "require": "./dist/web/index.cjs",
      "default": "./dist/web/index.cjs"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "react-native": "./dist/native/index.cjs",
      "import": "./dist/native/index.mjs",
      "require": "./dist/native/index.cjs",
      "default": "./dist/native/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup src/index.ts src/web/index.ts src/native/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inkweaver/shared": "workspace:*",
    "expo-sqlite": "^55.0.13"
  },
  "devDependencies": {
    "dexie": "^4.4.2",
    "eslint": "^9.33.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}