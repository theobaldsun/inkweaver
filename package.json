{
  "name": "InkWeaver",
  "version": "1.0.0",
  "description": "SyncBox-AI - Cross-platform note-taking application with local-first architecture",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "turbo run dev --filter=@inkweaver/server",
    "dev:admin": "turbo run dev --filter=@inkweaver/admin",
    "dev:h5": "turbo run dev --filter=@inkweaver/h5",
    "dev:mobile": "turbo run start --filter=@inkweaver/mobile",
    "dev:web": "turbo run dev --filter=@inkweaver/web",
    "dev:mobile:web": "pnpm --filter @inkweaver/mobile web",
    "dev:mobile:android": "pnpm --filter @inkweaver/mobile android",
    "dev:mobile:ios": "pnpm --filter @inkweaver/mobile ios",
    "dev:mobile:dev-client": "pnpm --filter @inkweaver/mobile dev",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@inkweaver/*",
    "build:apps": "turbo run build --filter=~@inkweaver/*",
    "build:server": "turbo run build --filter=@inkweaver/server",
    "build:admin": "turbo run build --filter=@inkweaver/admin",
    "build:h5": "turbo run build --filter=@inkweaver/h5",
    "build:web": "turbo run build --filter=@inkweaver/web",
    "build:mobile": "turbo run build --filter=@inkweaver/mobile",
    "build:editor-core": "turbo run build --filter=@inkweaver/editor-core",
    "build:editor-web": "turbo run build --filter=@inkweaver/editor-web",
    "build:editor-mobile": "turbo run build --filter=@inkweaver/editor-mobile",
    "build:sync-engine": "turbo run build --filter=@inkweaver/sync-engine",
    "build:api": "turbo run build --filter=@inkweaver/api",
    "build:services": "turbo run build --filter=@inkweaver/services",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @inkweaver/server test:integration",
    "audit:web-server": "node scripts/audit-web-server.mjs",
    "check:web-server": "pnpm typecheck && pnpm --filter @inkweaver/web lint && pnpm --filter @inkweaver/server lint && pnpm --filter @inkweaver/api test && pnpm --filter @inkweaver/adapters test && pnpm --filter @inkweaver/web test && pnpm --filter @inkweaver/server test && pnpm --filter @inkweaver/web build && pnpm --filter @inkweaver/server build && pnpm audit:web-server",
    "lint": "turbo run lint",
    "lint:packages": "turbo run lint --filter=@inkweaver/*",
    "lint:apps": "turbo run lint --filter=~@inkweaver/*",
    "format": "prettier . --write",
    "typecheck": "turbo run typecheck",
    "typecheck:packages": "turbo run typecheck --filter=@inkweaver/*",
    "typecheck:apps": "turbo run typecheck --filter=~@inkweaver/*",
    "start:server": "pnpm --filter @inkweaver/server start",
    "start:mobile": "pnpm --filter @inkweaver/mobile start",
    "prebuild:mobile": "pnpm --filter @inkweaver/mobile prebuild",
    "expo:build": "pnpm --filter @inkweaver/mobile build",
    "clean": "turbo run clean --parallel",
    "clean:cache": "turbo run clean --filter=!@inkweaver/mobile && pnpm --filter @inkweaver/mobile start --clear",
    "install:all": "pnpm install && pnpm --filter @inkweaver/mobile install"
  },
  "keywords": [
    "monorepo",
    "note-taking",
    "local-first",
    "cross-platform",
    "react",
    "react-native"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "overrides": {
      "lodash": "4.18.0",
      "linkify-it": "5.0.2",
      "multer": "2.2.0",
      "path-to-regexp": "8.4.0",
      "tar": "7.5.22"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "turbo": "^2.8.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.3"
  },
  "engines": {
    "node": ">=20.19.4",
    "pnpm": ">=8.0.0"
  }
}
