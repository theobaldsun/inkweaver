# 生产环境变量（复制为仓库根目录 .env.prod，勿提交 Git）
#   cp deploy/env.prod.example .env.prod
#
# docker compose 与 server 容器共用此文件（见 docker-compose.prod.yml）

# --- Docker Compose（postgres / redis）---
POSTGRES_PASSWORD=change-me-strong-postgres
REDIS_PASSWORD=change-me-strong-redis

# 宿主机上传目录（映射到容器 /app/uploads）
UPLOADS_HOST_PATH=/opt/inkweaver/uploads

# --- Nest Server ---
NODE_ENV=production
PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me-strong-postgres
DB_DATABASE=syncbox_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis

JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# 单域名：与 Nginx server_name 一致
APP_PUBLIC_URL=https://app.yourdomain.com
CORS_ORIGIN=https://app.yourdomain.com

# QQ 邮箱 SMTP（授权码，非 QQ 密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_qq@qq.com
SMTP_PASS=your-qq-smtp-authorization-code
SMTP_FROM=InkWeaver <your_qq@qq.com>

# 跳过启动时迁移（仅调试；正常留空）
# SKIP_MIGRATIONS=true
